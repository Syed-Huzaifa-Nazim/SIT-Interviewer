# Google OAuth client secrets (downloaded from Cloud Console — never commit)
client_secret*.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.env
# Backups/variants of an env file carry exactly the same secrets as the file itself.
# `*.env` alone does not match them: a .env.bak written before an edit was picked up by
# `git add -A` and staged for commit.
*.env.*
.env.*
.venv
venv/
ENV/
env/
instance/
.pytest_cache/

# Node
node_modules/
dist/
dist-ssr/
*.local
.eslintcache

# Databases
*.db
*.sqlite3

# Uploads and reports
backend/uploads/*
backend/reports/*
!backend/uploads/.gitkeep
!backend/reports/.gitkeep

# IDEs
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
