# =========================================================================
# AI Interviewer Configuration File (.env)
# =========================================================================

# 1. Execution Mode
# Set to 'mock' to run the entire system with mock AI evaluations, mock resume scoring, 
# and mock transcription. Perfect for offline development.
# Set to 'api' to make live requests to Mixtral/Whisper models.
AI_MODE=mock

# 2. Database Configuration
# Defaults to a local SQLite file (interviewer.db) inside the backend folder.
# For production (or Docker Compose), uncomment and configure the line below:
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_interviewer

# 3. JWT Authentication Secrets
# Change this to a secure random string in production environments.
JWT_SECRET_KEY= 

# 4. AI Provider Integration (Only required if AI_MODE=api)
# We support 'groq', 'together', or 'openai' compatible endpoints.
AI_PROVIDER=groq

# Groq API Configuration (Fastest option for Mixtral/Whisper)
MIXTRAL_API_KEY= JI11Pm6osjeaKAcmjNQfR8uDnYzk1Sku
WHISPER_API_KEY=your_groq_api_key_here

# API Custom Endpoint Overrides (if using Together AI or OpenAI instead of Groq)
# For Together AI:
# MIXTRAL_API_URL=https://api.together.xyz/v1/chat/completions
# WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
# MIXTRAL_API_KEY=your_together_api_key_here
# WHISPER_API_KEY=your_openai_api_key_here
