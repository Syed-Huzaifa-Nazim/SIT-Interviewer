# =========================================================================
# AI Interviewer Configuration File (.env)
# =========================================================================

# 1. Execution Mode
# Set to 'mock' to run the entire system with mock AI evaluations, mock resume scoring, 
# and mock transcription. Perfect for offline development.
# Set to 'api' to make live requests to Mixtral/Whisper models.
AI_MODE=mock

# 2. Database Configuration (REQUIRED — PostgreSQL/Supabase only, no SQLite fallback)
# The app refuses to start without a Postgres DATABASE_URL. For the shared hosted
# database, use your Supabase project's connection string:
#   Supabase Dashboard -> Project Settings -> Database -> Connection string (URI).
#   Prefer the "Session pooler" variant — the direct db.<ref>.supabase.co host is
#   IPv6-only and often unreachable from home/IPv4 networks.
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# 3. JWT Authentication Secrets
# Change this to a secure random string in production environments.
JWT_SECRET_KEY= 

# 4. AI Provider Integration (Only required if AI_MODE=api)
# We support 'groq', 'together', 'openai', or 'openrouter' compatible endpoints.
AI_PROVIDER=groq

# Chat model key (matches AI_PROVIDER above — e.g. an OpenRouter key for openrouter)
MIXTRAL_API_KEY=your_chat_provider_key_here

# Speech-to-text is a SEPARATE provider. OpenRouter has NO audio endpoint, so this MUST
# be a Groq key (free Whisper-large-v3) or an OpenAI key — NOT your OpenRouter key.
WHISPER_PROVIDER=groq
WHISPER_API_KEY=your_groq_or_openai_key_here

# 5. Chat model + call tuning (optional; sensible per-provider defaults are used)
# The default is a strong Llama-3.3-70B class model per provider. Override if needed:
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct
# LLM_TIMEOUT=30        # seconds per request
# LLM_MAX_RETRIES=2     # retries before falling back

# API Custom Endpoint Overrides (if using Together AI, OpenAI, or OpenRouter instead of Groq)
# For OpenRouter:
# MIXTRAL_API_URL=https://openrouter.ai/api/v1/chat/completions
# For Together AI:
# MIXTRAL_API_URL=https://api.together.xyz/v1/chat/completions
# WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions

# 6. Email Service (Python smtplib — no paid third-party provider)
# 'console' (default) prints rendered emails to the server log: zero credentials
# needed, ideal for dev/testing. Switch to 'smtp' for real delivery.
# EMAIL_MODE=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-address@gmail.com
# SMTP_PASSWORD=your-gmail-app-password   # keep secrets out of version control
# SMTP_USE_TLS=True             # STARTTLS on port 587
# SMTP_USE_SSL=False            # set True with SMTP_PORT=465 instead of TLS
# EMAIL_FROM=your-address@gmail.com
# EMAIL_FROM_NAME=SMIT Assessment Portal
# EMAIL_MAX_RETRIES=2
# EMAIL_RETRY_DELAY=3
# Deliverability: use a From address on a domain you control and ensure the domain's
# SPF/DKIM records authorize the SMTP host you relay through (automatic for Gmail).

# Base URL used for links inside emails (login page, admin approval queue)
# APP_BASE_URL=http://localhost:5173

# 7. Supabase Storage (profile pictures + recorded interview answer audio)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=your_supabase_service_role_key
# SUPABASE_BUCKET=profile-pictures
# Recorded interview audio is uploaded directly to this bucket (create it in your
# Supabase project). If Supabase is unconfigured/unreachable, the backend falls back
# to keeping the recording on local disk (backend/uploads) rather than losing it.
# SUPABASE_AUDIO_BUCKET=interview-audio
